{
  "name": "chenglan-music",
  "version": "0.7.3",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": ">=24.11.0" },
  "scripts": {
    "dev": "concurrently -k -n server,web \"tsx watch apps/server/src/index.ts\" \"vite --config apps/web/vite.config.ts\"",
    "build": "tsc --noEmit && vite build --config apps/web/vite.config.ts && tsup apps/server/src/index.ts --format esm --platform node --target node24 --out-dir apps/server/dist",
    "start": "node apps/server/dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval": "tsx evaluation/run.ts",
    "test:watch": "vitest",
    "test:ui": "tsx tests/ui-fixture.ts",
    "open": "node scripts/start.mjs",
    "stop": "node scripts/start.mjs --stop",
    "restore": "node scripts/restore.mjs",
    "lint": "eslint ."
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^8.3.0",
    "@hookform/resolvers": "^5.2.2",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@tanstack/react-query": "^5.90.0",
    "better-sqlite3": "13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "fflate": "^0.8.2",
    "ipaddr.js": "^2.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.62.0",
    "react-router-dom": "^7.9.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "undici": "^7.16.0",
    "wavesurfer.js": "^7.11.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.1.13",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "tailwindcss": "^4.1.13",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
